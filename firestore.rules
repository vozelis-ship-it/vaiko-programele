rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vienas dokumentas vienai šeimai; dokumento ID = slaptas šeimos kodas (12–64 simboliai).
    // Sąrašo skaitymas ir trynimas uždrausti, todėl kodo atspėti negalima.
    match /families/{fid} {
      allow get, create, update: if fid.size() >= 12 && fid.size() <= 64;
      allow list, delete: if false;
    }
  }
}
